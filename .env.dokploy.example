APP_NAME=Sanad
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_PORT=8091
APP_URL=https://sanad.wattlesol.com
ASSET_URL=https://sanad.wattlesol.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sanad
DB_USERNAME=sanad
DB_PASSWORD=change-this-sanad-password
MYSQL_ROOT_PASSWORD=change-this-sanad-root-password
MYSQL_PUBLIC_PORT=3306

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

RESTORE_DB_ON_BOOT=true
RESTORE_DB_IF_EMPTY=true
RESTORE_DB_FRESH=false
RESTORE_DB_DUMP=database/dumps/kangoo_sa.sql.gz

RUN_MIGRATIONS=false
RUN_SEEDERS=false

SANAD_AI_ENABLED=true
SANAD_AI_PROVIDER=nvidia
SANAD_AI_TEMPERATURE=0.2
SANAD_AI_MAX_TOKENS=2048
SANAD_AI_ESCALATION_THRESHOLD=0.65
SANAD_VECTOR_STORE=database
SANAD_RAG_CHUNK_SIZE=900
SANAD_RAG_CHUNK_OVERLAP=120
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_AI_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
CHROMA_PUBLIC_PORT=8001
CHROMA_COLLECTION=sanad_knowledge_base
CRAWL4AI_PUBLIC_PORT=11235
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT=15
CRAWL4AI_MAX_PAGES=50
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=sanad-rag
LANGSMITH_API_KEY=
HONCHO_ENABLED=false
HONCHO_API_KEY=
HONCHO_BASE_URL=http://honcho:8000
