					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ecommerce/products?created_by_type=provider&with_stats=true",
							"host": ["{{base_url}}"],
							"path": ["api", "ecommerce", "products"],
							"query": [
								{
									"key": "created_by_type",
									"value": "provider"
								},
								{
									"key": "with_stats",
									"value": "true"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "📋 Common Data",
			"item": [
