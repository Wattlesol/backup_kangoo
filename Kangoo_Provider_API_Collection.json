{
	"info": {
		"_postman_id": "kangoo-provider-api-collection",
		"name": "Kangoo Provider API Collection",
		"description": "Provider-specific API endpoints for Kangoo Service Platform",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8001",
			"type": "string"
		},
		{
			"key": "provider_token",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{provider_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "🔐 Provider Authentication",
			"item": [
				{
					"name": "Register Provider",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"first_name\": \"Provider\",\n    \"last_name\": \"Business\",\n    \"email\": \"provider@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"user_type\": \"provider\",\n    \"phone\": \"+1234567890\",\n    \"company_name\": \"Provider Business LLC\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/register",
							"host": ["{{base_url}}"],
							"path": ["api", "register"]
						}
					}
				},
				{
					"name": "Provider Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.api_token) {",
									"        pm.collectionVariables.set('provider_token', response.data.api_token);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"provider@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": ["{{base_url}}"],
							"path": ["api", "login"]
						}
					}
				},
				{
					"name": "Provider Dashboard",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/provider-dashboard",
							"host": ["{{base_url}}"],
							"path": ["api", "provider-dashboard"]
						}
					}
				}
			]
		},
		{
			"name": "🛍️ Product Management",
			"item": [
				{
					"name": "Create Provider Product",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Provider Product\",\n    \"description\": \"Product from provider\",\n    \"base_price\": 99.99,\n    \"product_category_id\": 1,\n    \"sku\": \"PROV-001\",\n    \"stock_quantity\": 100,\n    \"status\": 1,\n    \"is_featured\": 0,\n    \"weight\": 1.5,\n    \"dimensions\": \"10x10x5\",\n    \"created_by_type\": \"provider\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/ecommerce/products",
							"host": ["{{base_url}}"],
							"path": ["api", "ecommerce", "products"]
						}
					}
				},
				{
					"name": "Get My Products",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ecommerce/products?created_by_type=provider&per_page=15",
							"host": ["{{base_url}}"],
							"path": ["api", "ecommerce", "products"],
							"query": [
								{
									"key": "created_by_type",
									"value": "provider"
								},
								{
									"key": "per_page",
									"value": "15"
								}
							]
						}
					}
				},
				{
					"name": "Get My Pending Products",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ecommerce/products?created_by_type=provider&approval_status=pending&per_page=15",
							"host": ["{{base_url}}"],
							"path": ["api", "ecommerce", "products"],
							"query": [
								{
									"key": "created_by_type",
									"value": "provider"
								},
								{
									"key": "approval_status",
									"value": "pending"
								},
								{
									"key": "per_page",
									"value": "15"
								}
							]
						}
					}
				},
				{
					"name": "Update My Product",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Provider Product\",\n    \"base_price\": 129.99,\n    \"stock_quantity\": 75\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/ecommerce/products/1",
							"host": ["{{base_url}}"],
							"path": ["api", "ecommerce", "products", "1"]
						}
					}
				},
				{
					"name": "Delete My Product",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ecommerce/products/1",
							"host": ["{{base_url}}"],
							"path": ["api", "ecommerce", "products", "1"]
						}
					}
				}
			]
		},
		{
			"name": "📦 Order Management",
			"item": [
				{
					"name": "Get My Orders",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/my-orders?status=pending&per_page=20",
							"host": ["{{base_url}}"],
							"path": ["api", "my-orders"],
							"query": [
								{
									"key": "status",
									"value": "pending"
								},
								{
									"key": "per_page",
									"value": "20"
								}
							]
						}
					}
				},
				{
					"name": "Get Order Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ecommerce/orders/1",
							"host": ["{{base_url}}"],
							"path": ["api", "ecommerce", "orders", "1"]
						}
					}
				},
				{
					"name": "Update Order Status",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"shipped\",\n    \"notes\": \"Order has been shipped\",\n    \"tracking_number\": \"TRK123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/ecommerce/orders/1/status",
							"host": ["{{base_url}}"],
							"path": ["api", "ecommerce", "orders", "1", "status"]
						}
					}
				}
			]
		},
		{
			"name": "📊 Analytics & Reports",
			"item": [
				{
					"name": "Provider Dashboard Stats",
					"request": {
						"method": "GET",
						"header": [],
